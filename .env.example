# Copy to .env (never commit real values) or set these as environment variables.

# Server
PORT=3000
# Game clock speed multiplier (1 = real time). Dev/testing only.
TIME_SCALE=1
# Username that becomes the moderator account. If unset, the first registered
# account becomes mod.
MOD_USERNAME=

# Database — Turso (production) or a local SQLite file (dev, no Turso needed).
# Local dev: leave unset or use file:./game.db
# Turso: get these from `turso db show <db>` / your Turso dashboard
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Discord notifications (optional — leave blank to disable).
# Create a webhook: Discord server → Server Settings → Integrations → Webhooks → New Webhook.
DISCORD_WEBHOOK_URL=
# Optional: prepend a mention to every notification, e.g. @here (must be allowed in channel)
DISCORD_MENTION=
# Public site URL used for links inside notifications
SITE_URL=https://frcprizepicks.onrender.com
